# --- Secrets: never commit keys, certificates or local configuration ---
*.p12
*.cer
*.mobileprovision
*.provisionprofile
.env
.env.*
Secrets.xcconfig
LocalOverrides.xcconfig
*.key
*.pem

# --- User data, backups and exports must never be committed ---
*.iqdb
*.iqbackup
*-export.csv
*.sqlite
*.sqlite-wal
*.sqlite-shm

# --- Tooling ---
.vscode/
.idea/
*.swp

# Local-only proxy CA certificates for ci/Dockerfile.linux
ci/extra-ca/*.crt
.build-linux/
