# --- macOS / Xcode ---
.DS_Store
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace
*.xcresult

# --- Swift Package Manager ---
.build/
.swiftpm/
Packages/
