          }
        }
      }
    },
    "metric.pe": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena/zisk (P/E)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Price/earnings (P/E)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена/прибыль (P/E)"
          }
        }
      }
    },
    "metric.pe.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena akcie vydělená ziskem na akcii. Vysoká hodnota může znamenat, že vysoká očekávání už jsou v ceně. Při záporném zisku nemá smysl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share price divided by earnings per share. A high value can mean high expectations are already priced in. Not meaningful when earnings are negative."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена акции, делённая на прибыль на акцию. Высокое значение может означать, что высокие ожидания уже заложены в цену. Не имеет смысла при отрицательной прибыли."
          }
        }
      }
    },
