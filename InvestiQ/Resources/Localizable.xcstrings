    "analytics.volatility.explanation": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Denní pohyby ceny odpovídaly přibližně %@ ročně. Na klidném trhu je hodnota nižší, na neklidném vyšší."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily price moves corresponded to about %@ per year. In calmer markets this figure is lower, in turbulent ones higher."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дневные колебания цены соответствовали примерно %@ в год. На спокойном рынке показатель ниже, на турбулентном — выше."
          }
        }
      }
    },
    "app.error.databaseUnreadable": {
