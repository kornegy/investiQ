    "onboarding.welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovědi pomohou InvestiQ vysvětlovat srozumitelně a upozornit na bezpečnostní témata, jako je finanční rezerva. Nikdy se nepoužívají k doporučování konkrétních investic."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answers help InvestiQ explain things in the right way and point out safety topics such as an emergency fund. They are never used to recommend specific investments."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы помогут InvestiQ объяснять материал понятнее и обращать внимание на вопросы безопасности, например на финансовую подушку. Они никогда не используются для рекомендаций конкретных инвестиций."
          }
        }
      }
    },
    "onboarding.welcome.privacy": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdy nežádáme doklady, bankovní hesla, údaje o kartách ani přístup k účtům. Odpovědi se ukládají pouze na tomto Macu, šifrovaně."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We never ask for ID documents, bank passwords, card details or account access. Answers are stored only on this Mac, encrypted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы никогда не запрашиваем документы, банковские пароли, данные карт или доступ к счетам. Ответы хранятся только на этом Mac в зашифрованном виде."
          }
        }
      }
    },
