    "asset.chart.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Závěrečné ceny za zvolené období. Minulé ceny nepředpovídají budoucí."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing prices for the selected period. Past prices do not predict future prices."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены закрытия за выбранный период. Прошлые цены не предсказывают будущие."
