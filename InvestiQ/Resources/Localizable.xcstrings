    "auth.error.biometric.entitlementMissing": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odemknutí pomocí Touch ID vyžaduje sestavení podepsané vývojářským týmem. Použijte heslo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID unlock requires an app build signed with a developer team. Use your password."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для разблокировки по Touch ID нужна сборка, подписанная командой разработчика. Используйте пароль."
          }
        }
      }
    },
    "auth.error.biometric.lockedOut": {
