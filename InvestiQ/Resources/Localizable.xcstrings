    "notifications.notAllowed": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokud oznámení nepovolíte, nic se nekontroluje ani neposílá. Změnit to lze v Nastavení systému → Oznámení."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until you allow notifications, nothing is checked or sent. You can change this later in System Settings → Notifications."
          }
        },
