    "profile.create.passwordWarning": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Heslo šifruje vaše data. Nelze ho obnovit — pokud ho zapomenete, data obnovíte jen ze zálohy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password encrypts your data. It cannot be recovered — if you forget it, only a backup can restore your data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль шифрует ваши данные. Его нельзя восстановить — если вы его забудете, вернуть данные можно только из резервной копии."
          }
        }
      }
    },
