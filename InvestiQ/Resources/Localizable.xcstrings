    "overview.risk.currency": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ aktiv se obchoduje v %1$@. Pohyby kurzu ovlivňují hodnotu v základní měně."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ of holdings trade in %1$@. Exchange-rate moves affect the value in your base currency."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ активов торгуется в %1$@. Колебания курса влияют на стоимость в базовой валюте."
          }
        }
      }
    },
    "overview.risk.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzdělávací postřehy podle jednoduchých zveřejněných pravidel. Nejde o doporučení."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Educational observations based on simple, published rules. They are not recommendations."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Образовательные наблюдения на основе простых опубликованных правил. Это не рекомендации."
          }
        }
      }
    },
    "overview.risk.missingPrices": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro %@ pozic chybí aktuální cena — celkovou hodnotu nelze plně spočítat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No current price for %@ holdings — the total value cannot be calculated completely."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет текущей цены для позиций: %@ — общую стоимость нельзя рассчитать полностью."
          }
        }
      }
    },
