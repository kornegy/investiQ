    "brokers.protectionWarning": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systémy odškodnění investorů mohou vyplatit náhradu, pokud zprostředkovatel selže a majetek klientů chybí. Nikdy nechrání před poklesem cen ani investičními ztrátami."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Investor compensation schemes may pay out if an intermediary fails and client assets are missing. They never protect against falling prices or investment losses."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системы компенсации инвесторам могут выплатить деньги, если посредник обанкротится и активы клиентов пропадут. Они никогда не защищают от падения цен и инвестиционных убытков."
          }
        }
      }
    },
