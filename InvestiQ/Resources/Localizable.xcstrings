    "transaction.fx.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechte prázdné, chcete-li použít oficiální kurz ECB/ČNB ke dni obchodu, je-li k dispozici."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty to use the official ECB/CNB rate of the trade date when available."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы использовать официальный курс ЕЦБ/ЧНБ на дату сделки, если он доступен."
          }
        }
      }
    },
    "transaction.split.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příklad: split 4 za 1 je 4 : 1. Pořizovací cena se nemění, mění se jen počet akcií."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: a 4-for-1 split is 4 : 1. The cost basis stays the same; only the number of shares changes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пример: сплит 4 к 1 — это 4 : 1. Себестоимость не меняется, меняется только количество акций."
          }
        }
      }
    },
