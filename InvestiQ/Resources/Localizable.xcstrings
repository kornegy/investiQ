    "onboarding.risk.acceptsLargeSwings": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přijímám velké výkyvy v dlouhém horizontu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I accept large swings over a long horizon"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принимаю сильные колебания на долгом горизонте"
          }
        }
      }
    },
    "onboarding.risk.avoidLosses": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechci zažít žádnou ztrátu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I would not want to experience any loss"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я не хочу допускать никаких убытков"
          }
        }
      }
    },
    "onboarding.risk.balanced": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bylo by mi to nepříjemné, ale držel bych se plánu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I would be uneasy but stick to my plan"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Было бы неприятно, но я придерживался бы плана"
          }
        }
      }
    },
    "onboarding.risk.cautious": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velmi bych se znepokojil a možná prodal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I would be very worried and might sell"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сильно переживал бы и мог бы продать"
          }
        }
      }
    },
    "onboarding.risk.note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neexistuje správná odpověď. Postoj k riziku je jen část obrazu — schopnost unést ztráty závisí na vašich financích."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no right answer. Attitude to risk is only one part of the picture — your ability to absorb losses depends on your finances."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правильного ответа нет. Отношение к риску — лишь часть картины: способность пережить убытки зависит от ваших финансов."
          }
        }
      }
    },
    "onboarding.risk.question": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Představte si, že vaše investice během několika měsíců klesla o 20 %. Co byste nejspíš udělali?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine your investment fell by 20 % within a few months. What would you most likely do?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Представьте, что ваши вложения подешевели на 20 % за несколько месяцев. Как бы вы, скорее всего, поступили?"
          }
        }
      }
    },
    "onboarding.risk.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolísání hodnoty"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluctuations in value"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Колебания стоимости"
          }
        }
      }
    },
    "onboarding.summary.educationalMode": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bude zapnut vzdělávací režim: pouze virtuální portfolia a výuka."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Educational mode will be enabled: virtual portfolios and learning only."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет включён учебный режим: только виртуальные портфели и обучение."
          }
        }
      }
    },
    "onboarding.summary.noNotes": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z vašich odpovědí nevyplývají žádná zvláštní bezpečnostní témata. Odpovědi můžete kdykoli změnit v nastavení."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No safety topics stand out from your answers. You can change them anytime in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По вашим ответам особых вопросов безопасности не выявлено. Ответы можно изменить в настройках."
          }
        }
      }
    },
    "onboarding.summary.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než začnete"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you start"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед началом"
          }
        }
      }
    },
    "onboarding.welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovědi pomohou InvestiQ vysvětlovat srozumitelně a upozornit na bezpečnostní témata, jako je finanční rezerva. Nikdy se nepoužívají k doporučování konkrétních investic."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answers help InvestiQ explain things in the right way and point out safety topics such as an emergency fund. They are never used to recommend specific investments."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы помогут InvestiQ объяснять материал понятнее и обращать внимание на вопросы безопасности, например на финансовую подушку. Они никогда не используются для рекомендаций конкретных инвестиций."
          }
        }
      }
    },
    "onboarding.welcome.privacy": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdy nežádáme doklady, bankovní hesla, údaje o kartách ani přístup k účtům. Odpovědi se ukládají pouze na tomto Macu, šifrovaně."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We never ask for ID documents, bank passwords, card details or account access. Answers are stored only on this Mac, encrypted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы никогда не запрашиваем документы, банковские пароли, данные карт или доступ к счетам. Ответы хранятся только на этом Mac в зашифрованном виде."
          }
        }
      }
    },
    "onboarding.welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve pár otázek"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few questions first"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала несколько вопросов"
          }
        }
      }
    },
