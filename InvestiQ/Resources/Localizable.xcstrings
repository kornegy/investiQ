    "brokers.protection.note.czGFOCP": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Garanční fond obchodníků s cennými papíry: náhrada, pokud firma nemůže vrátit majetek klientů; nikoli za investiční ztráty."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Czech Guarantee Fund of Securities Traders: compensation if the firm cannot return client assets; not for investment losses."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чешский гарантийный фонд торговцев ценными бумагами: компенсация, если компания не может вернуть активы клиентов; не за инвестиционные убытки."
          }
        }
      }
    },
    "brokers.protection.note.kdpw": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Polský systém: 100 % do 3 000 EUR a 90 % nad tuto částku, nejvýše 20 100 EUR na investora (podle KDPW)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Polish scheme: 100 % up to EUR 3,000 and 90 % above, at most EUR 20,100 per investor (per KDPW)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Польская система: 100 % до 3 000 EUR и 90 % сверх этого, не более 20 100 EUR на инвестора (по данным KDPW)."
          }
        }
      }
    },
    "brokers.protection.note.retailOnly": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryje jen způsobilé drobné klienty, nikoli profesionální a institucionální."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Covers eligible retail clients only, not professional or institutional clients."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покрывает только соответствующих требованиям розничных клиентов, не профессиональных и институциональных."
          }
        }
      }
    },
