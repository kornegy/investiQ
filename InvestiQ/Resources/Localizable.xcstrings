          "stringUnit": {
            "state": "translated",
            "value": "Ollama a model si nainstalujte sami; InvestiQ modely nestahuje. Přijímají se jen adresy tohoto Macu (127.0.0.1 nebo localhost), takže nic neopustí váš počítač."
          }
        },
        "en": {
          "stringUnit": {
