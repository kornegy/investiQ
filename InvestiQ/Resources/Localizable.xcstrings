    "news.classifiedBecause": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařazeno, protože text obsahuje „%@“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Classified because the text contains “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Классифицировано, так как текст содержит «%@»."
          }
        }
      }
    },
    "news.copyrightNote": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazují se jen titulky a krátká shrnutí; celý text si přečtěte u zdroje."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only headlines and short summaries are shown; read the full text at the source."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны только заголовки и краткие описания; полный текст читайте в источнике."
          }
        }
      }
    },
    "news.effect.caveat": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jde o možné kanály vlivu, ne o předpovědi. Stejná zpráva může vyvolat různou reakci trhu podle očekávání a dalších okolností."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are possible channels, not predictions. The same news can lead to different market reactions depending on expectations and other circumstances."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это возможные каналы влияния, а не прогнозы. Одна и та же новость может вызвать разную реакцию рынка в зависимости от ожиданий и других обстоятельств."
          }
        }
      }
    },
    "news.effect.centralBanks": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozhodnutí a prohlášení centrálních bank ovlivňují úrokové sazby, náklady půjček a měnové kurzy. Trhy často reagují spíše na rozdíl oproti očekávání než na samotné rozhodnutí."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Central bank decisions and statements influence interest rates, borrowing costs and exchange rates. Markets often react more to the difference from expectations than to the decision itself."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решения и заявления центральных банков влияют на ставки, стоимость заимствований и курсы валют. Рынки часто реагируют скорее на отличие от ожиданий, чем на само решение."
          }
        }
      }
    },
    "news.effect.corporateEarnings": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledky firmy mohou změnit pohled investorů na budoucí zisky; reakce ceny závisí na srovnání s očekáváním, nejen na tom, zda vypadají dobře či špatně."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Company results can change investors' view of future profits; the price reaction depends on how results compare with expectations, not only on whether they look good or bad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты компании могут изменить взгляд инвесторов на будущую прибыль; реакция цены зависит от сравнения с ожиданиями, а не только от того, хороши ли результаты."
          }
        }
      }
    },
    "news.effect.czechEconomy": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "České ekonomické údaje a rozhodnutí ČNB mohou ovlivnit kurz koruny, české úrokové sazby a firmy zaměřené na domácí trh."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Czech economic data and ČNB decisions can affect the koruna exchange rate, Czech interest rates and companies focused on the domestic market."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чешские экономические данные и решения ЧНБ могут влиять на курс кроны, чешские ставки и компании, ориентированные на внутренний рынок."
          }
        }
      }
    },
    "news.effect.employment": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje z trhu práce mohou ovlivnit očekávání ohledně spotřeby, mezd a politiky centrálních bank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Labour market data can influence expectations about consumer spending, wages and central bank policy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные рынка труда могут влиять на ожидания относительно потребительских расходов, зарплат и политики центральных банков."
          }
        }
      }
    },
    "news.effect.energy": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny energií různě ovlivňují náklady firem a domácností, inflaci a zisky výrobců energie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy prices affect costs for companies and households, inflation and the profits of energy producers in different ways."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены на энергию по-разному влияют на расходы компаний и домохозяйств, инфляцию и прибыль производителей энергии."
          }
        }
      }
    },
    "news.effect.europeanMarkets": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dění v Evropě může ovlivnit investice s evropskou expozicí včetně fondů a kurz eura."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developments in Europe can affect investments with European exposure, including funds, and the euro exchange rate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "События в Европе могут влиять на вложения с европейской экспозицией, включая фонды, и на курс евро."
          }
        }
      }
    },
    "news.effect.geopolitics": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Politické události mohou ovlivnit obchod, ceny energií, měny a ochotu riskovat. Dopady jsou často nejisté a mohou se rychle obrátit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Political events can affect trade, energy prices, currencies and willingness to take risk. Effects are often uncertain and can reverse quickly."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Политические события могут влиять на торговлю, цены на энергию, валюты и готовность рисковать. Последствия часто неопределённы и могут быстро меняться на противоположные."
          }
        }
      }
    },
    "news.effect.globalEconomy": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny hospodářského růstu mohou ovlivnit tržby a zisky firem a poptávku po surovinách."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes in economic growth can affect company sales and profits and the demand for raw materials."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения экономического роста могут влиять на продажи и прибыль компаний и на спрос на сырьё."
          }
        }
      }
    },
    "news.effect.inflation": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje o inflaci mohou změnit očekávání ohledně sazeb a reálnou hodnotu pevných plateb, například kuponů."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inflation data can change expectations about interest rates and the real value of fixed payments such as bond coupons."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные об инфляции могут менять ожидания по ставкам и реальную стоимость фиксированных выплат, например купонов."
          }
        }
      }
    },
    "news.effect.interestRates": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny úrokových sazeb mohou ovlivnit náklady půjček, ocenění firem a ceny existujících dluhopisů, které se obvykle pohybují opačně než výnosy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes in interest rates can affect borrowing costs, company valuations and the prices of existing bonds, which tend to move opposite to yields."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения ставок могут влиять на стоимость заимствований, оценку компаний и цены уже выпущенных облигаций, которые обычно движутся противоположно доходностям."
          }
        }
      }
    },
    "news.effect.regulation": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nová pravidla mohou změnit náklady, konkurenci nebo způsob prodeje produktů; dopad závisí na podrobnostech a jejich zavedení."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New rules can change costs, competition or how products may be sold; the effect depends on the details and their implementation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые правила могут менять расходы, конкуренцию или порядок продажи продуктов; эффект зависит от деталей и их применения."
          }
        }
      }
    },
    "news.effect.technology": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Technologický vývoj může změnit konkurenci a očekávání růstu v odvětví; tato očekávání už často jsou v cenách."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Technology developments can change competition and growth expectations in the sector; such expectations are often already reflected in prices."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Технологические изменения могут менять конкуренцию и ожидания роста в отрасли; такие ожидания часто уже учтены в ценах."
          }
        }
      }
    },
    "news.effect.usMarkets": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dění v USA může ovlivnit investice s americkou expozicí — včetně mnoha světových fondů — a kurz dolaru."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developments in the United States can affect investments with US exposure — including many world funds — and the dollar exchange rate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "События в США могут влиять на вложения с американской экспозицией, включая многие мировые фонды, и на курс доллара."
          }
        }
      }
    },
    "news.effects": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Možné souvislosti"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Possible connections"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможные связи"
          }
        }
      }
    },
    "news.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte zdroj zpráv v Nastavení → Poskytovatelé dat nebo změňte filtry."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable a news source in Settings → Data Providers, or change the filters."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите источник новостей в Настройках → Поставщики данных или измените фильтры."
          }
        }
      }
    },
    "news.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné zprávy"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No news"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет новостей"
          }
        }
      }
    },
    "news.error.loadFailed": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené zprávy se nepodařilo načíst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved news could not be loaded."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить сохранённые новости."
          }
        }
      }
    },
    "news.error.refreshFailed": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zprávy se nepodařilo obnovit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "News could not be refreshed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить новости."
          }
        }
      }
    },
    "news.eventDate": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "· datum události %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "· event date %@"
          }
        },
        "ru": {
