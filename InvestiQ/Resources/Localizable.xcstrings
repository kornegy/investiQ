          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pearson correlation of daily returns over the last year for pairs of holdings. Correlations change over time and tend to rise in crises."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Корреляция Пирсона дневных доходностей за последний год для пар позиций. Корреляции меняются со временем и обычно растут в кризисы."
          }
        }
      }
    },
