    "asset.fundamentals.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje zveřejněné firmou nebo poskytovatelem dat. Najetím na ukazatel zobrazíte vysvětlení."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Figures reported by the company or a data provider. Hover over each metric for an explanation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные, раскрытые компанией или поставщиком данных. Наведите на показатель, чтобы увидеть объяснение."
          }
        }
      }
    },
    "asset.fundamentals.missingNote": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„není k dispozici“ znamená, že zdroj hodnotu neposkytl — nejde o nulu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"n/a\" means the source did not provide the value — it is not zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«нет данных» означает, что источник не предоставил значение, а не что оно равно нулю."
          }
        }
      }
    },
