    "ai.consent.agree": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhlasím, zapnout"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I agree, enable"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Согласен, включить"
          }
        }
      }
    },
    "ai.consent.body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše otázky a texty, na které se ptáte, se budou odesílat do Claude API společnosti Anthropic s vaším klíčem a zpracovávat podle jejích podmínek. Částky, pozice, transakce ani údaje profilu se neodesílají. Vypnout to můžete kdykoli."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your questions and the texts you ask about will be sent to Anthropic's Claude API using your own key and processed under their terms. No amounts, holdings, transactions or profile data are sent. You can switch this off at any time."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши вопросы и тексты, о которых вы спрашиваете, будут отправляться в Claude API компании Anthropic с вашим ключом и обрабатываться по её условиям. Суммы, позиции, сделки и данные профиля не отправляются. Отключить можно в любой момент."
          }
        }
      }
    },
    "ai.consent.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesílat otázky externí službě AI?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send questions to an external AI service?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлять вопросы внешнему сервису ИИ?"
          }
        }
      }
    },
    "ai.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovědi AI mohou být chybné. Jsou to obecná vysvětlení, ne rady, a neukládají se s vašimi daty."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI answers can be wrong. They are general explanations, not advice, and are not saved with your data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы ИИ могут быть ошибочными. Это общие объяснения, а не советы, и они не сохраняются вместе с вашими данными."
          }
        }
      }
    },
    "ai.error.blockedSensitiveData": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požadavek obsahoval heslo nebo klíč a nebyl odeslán."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request contained a password or key and was not sent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос содержал пароль или ключ и не был отправлен."
          }
        }
      }
    },
    "ai.error.consentRequired": {
      "extractionState": "manual",
      "localizations": {
