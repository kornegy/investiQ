    "asset.chart.unadjusted": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny nejsou upraveny o splity; skoky mohou způsobit korporátní akce."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These prices are not adjusted for splits; jumps can be caused by corporate actions."
