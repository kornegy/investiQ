    "rule.default": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné pravidlo se nespustilo. Jako u každého nástroje je stále potřeba vlastní průzkum."
