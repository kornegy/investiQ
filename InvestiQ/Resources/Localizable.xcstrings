          "stringUnit": {
            "state": "translated",
            "value": "Синтетические ETF зависят от контрагентов по свопам; большая доля денежных средств зависит от банка или брокера, где они хранятся."
          }
        }
      }
    },
    "risk.credit.explanation": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podíl portfolia v dluhopisech s ratingem pod investičním stupněm nebo bez ratingu (prahy 0 / 10 / 30 %)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share of the portfolio in individual bonds rated below investment grade or unrated (thresholds 0 / 10 / 30 %)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доля портфеля в облигациях с рейтингом ниже инвестиционного или без рейтинга (пороги 0 / 10 / 30 %)."
          }
        }
      }
    },
    "risk.credit.noBonds": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Portfolio neobsahuje jednotlivé dluhopisy. Dluhopisové fondy nesou úvěrové riziko podle svého složení."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The portfolio holds no individual bonds. Bond funds carry credit risk that depends on their holdings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В портфеле нет отдельных облигаций. Облигационные фонды несут кредитный риск в зависимости от своего состава."
          }
        }
      }
    },
    "risk.currency.explanation": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podíl portfolia v jiných měnách než základní, s rozpadem fondů tam, kde je znám (prahy 10 / 40 / 70 %)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share of the portfolio in currencies other than the base currency, with fund look-through where known (thresholds 10 / 40 / 70 %)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доля портфеля в валютах, отличных от базовой, с учётом состава фондов, где он известен (пороги 10 / 40 / 70 %)."
          }
        }
      }
    },
    "risk.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte do portfolia transakce, abyste viděli jeho rizikový profil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add transactions to a portfolio to see its risk profile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте сделки в портфель, чтобы увидеть его профиль риска."
          }
        }
      }
    },
    "risk.empty.title": {
