    "scenario.noProbabilities": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádnému scénáři není přiřazena pravděpodobnost. Výsledky mimo toto rozpětí nastaly a mohou nastat znovu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No probability is attached to any scenario. Outcomes outside this range have happened and can happen again."
