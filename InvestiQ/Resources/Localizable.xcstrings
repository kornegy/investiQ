    "asset.metric.periodReturn.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna mezi první a poslední závěrečnou cenou období, bez dividend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change between the first and last closing price of the period, without dividends."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение между первой и последней ценой закрытия периода, без учёта дивидендов."
          }
        }
      }
    },
    "asset.metric.volatility": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volatilita (roční)"
          }
        },
        "en": {
