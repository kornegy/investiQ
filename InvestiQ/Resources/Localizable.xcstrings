      }
    },
    "rule.highVolatility": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Roční volatilita %@ je nad prahem 35 %%."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Annualised volatility of %@ is above the 35 %% threshold."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Годовая волатильность %@ выше порога 35 %%."
          }
        }
      }
    },
    "rule.insufficientData": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K dispozici je jen %@ klíčových ukazatelů, závěry jsou proto omezené."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only %@ of the key metrics are available, so conclusions are limited."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно только %@ ключевых показателей, поэтому выводы ограничены."
          }
        }
      }
    },
    "rule.marginDecline": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Provozní marže meziročně klesla o více než 5 procentních bodů."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operating margin fell by more than 5 percentage points year on year."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операционная маржа снизилась более чем на 5 процентных пунктов за год."
          }
        }
      }
    },
    "rule.negativeEarnings": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čistý zisk za posledních 12 měsíců je záporný."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Net income over the last 12 months is negative."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чистая прибыль за последние 12 месяцев отрицательная."
          }
        }
      }
    },
    "rule.negativeFCFTwoYears": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volné peněžní toky byly záporné v každém z posledních dvou účetních let."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free cash flow was negative in each of the last two fiscal years."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свободный денежный поток был отрицательным в каждом из двух последних финансовых лет."
          }
        }
      }
    },
    "rule.payoutAboveEarnings": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dividenda na akcii převyšuje zisk na akcii."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dividends per share exceed earnings per share."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дивиденд на акцию превышает прибыль на акцию."
          }
        }
      }
    },
    "rule.staleData": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Část dat je zastaralá."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some of the data is outdated."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть данных устарела."
          }
        }
      }
    },
    "rule.syntheticReplication": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fond replikuje index synteticky pomocí swapů, což přidává riziko protistrany."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fund replicates its index synthetically through swaps, which adds counterparty risk."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фонд воспроизводит индекс синтетически через свопы, что добавляет риск контрагента."
          }
        }
      }
    },
    "rule.unratedBond": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dluhopis nemá v dostupných datech úvěrový rating."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bond has no credit rating in the available data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В доступных данных у облигации нет кредитного рейтинга."
          }
        }
      }
    },
    "safety.debtDifficulty.body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze potřebné na splácení dluhů, bydlení, jídlo nebo zdravotní péči nejsou vhodné k investování. V mnoha zemích existuje bezplatné nezávislé dluhové poradenství."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money needed for debt repayment, housing, food or healthcare is not suitable for investing. Free, independent debt counselling is available in many countries."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги на погашение долгов, жильё, еду и лечение не подходят для инвестирования. Во многих странах доступны бесплатные независимые консультации по долгам."
          }
        }
      }
    },
    "safety.debtDifficulty.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potíže se splácením"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Difficulty repaying"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трудности с выплатами"
          }
        }
      }
    },
    "safety.educationalModeMinor.body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete se učit, používat kalkulačky a zkoušet virtuální portfolia. Skutečné investování vyžaduje účet dospělé osoby u regulovaného brokera."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can learn, use calculators and practise with virtual portfolios. Real investing requires an adult account at a regulated broker."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете учиться, пользоваться калькуляторами и тренироваться на виртуальных портфелях. Для реальных инвестиций нужен счёт совершеннолетнего у регулируемого брокера."
          }
        }
      }
    },
    "safety.educationalModeMinor.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzdělávací režim"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Educational mode"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учебный режим"
          }
        }
      }
    },
    "safety.highInterestDebt.body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úroky z kreditních karet a spotřebitelských úvěrů bývají vyšší než dlouhodobé výnosy investic — a jsou jisté, zatímco výnosy ne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest on credit cards and consumer loans is often higher than long-term investment returns, and it is certain while returns are not."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты по кредитным картам и потребкредитам часто выше долгосрочной доходности инвестиций — и они гарантированы, а доходность нет."
          }
        }
      }
    },
    "safety.highInterestDebt.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dluhy s vysokým úrokem"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High-interest debt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Долги с высокой ставкой"
          }
        }
      }
    },
    "safety.lossAversionVsVolatility.body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Akcie, dluhopisy i ETF mohou ztrácet hodnotu. Sekce Výuka vysvětluje, jak spolu souvisí riziko a možný výnos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocks, bonds and ETFs can all lose value. The Learn section explains how risk and potential return are connected."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Акции, облигации и ETF могут терять в стоимости. В разделе «Обучение» объясняется, как связаны риск и потенциальная доходность."
          }
        }
      }
    },
    "safety.lossAversionVsVolatility.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá investice může klesnout"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every investment can fall"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любая инвестиция может подешеветь"
          }
        }
      }
    },
    "safety.noEmergencyFund.body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peníze na nečekané výdaje se obvykle drží bezpečně a dostupně, ne v aktivech, jejichž hodnota může klesnout právě ve chvíli, kdy je budete potřebovat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money for unexpected expenses is usually kept safe and accessible, not invested in assets whose value can fall when you need it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги на непредвиденные расходы обычно держат в надёжном и доступном месте, а не в активах, которые могут подешеветь именно тогда, когда они понадобятся."
          }
        }
      }
    },
    "safety.noEmergencyFund.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve finanční rezerva"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emergency fund first"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала — финансовая подушка"
          }
        }
      }
    },
    "safety.shortHorizonVolatility.body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny akcií mohou zůstat pod předchozí úrovní i roky. Peníze potřebné do roka jsou tomuto riziku vystaveny, pokud jsou v kolísavých aktivech."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stock prices can stay below their previous level for years. Money needed within a year is exposed to that risk if it is invested in volatile assets."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены акций могут годами оставаться ниже прежнего уровня. Деньги, нужные в течение года, подвергаются этому риску, если вложены в волатильные активы."
          }
        }
      }
    },
    "safety.shortHorizonVolatility.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Krátký horizont"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short horizon"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткий горизонт"
          }
        }
      }
    },
    "safety.smallEmergencyFund.body": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvyklým vodítkem jsou 3–6 měsíců nezbytných výdajů. Finanční plán ukáže, jak dlouho by vaše současná rezerva vydržela."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A common guideline is 3–6 months of essential expenses. The Financial Planner shows how long your current reserve would last."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часто ориентируются на 3–6 месяцев обязательных расходов. Финансовый план покажет, на сколько хватит вашего текущего резерва."
          }
        }
      }
    },
    "safety.smallEmergencyFund.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
