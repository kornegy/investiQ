    "strategy.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zpětný test ukazuje jen jednu cestu, kterou minulost šla. Jiná období dávají jiné výsledky a je snadné vybrat rozložení, které jen sedí na minulost."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A back-test shows one path the past took. Other periods give different results, and it is easy to pick an allocation that merely fits the past."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бэктест показывает лишь один путь, по которому шло прошлое. Другие периоды дают иные результаты, и легко подобрать структуру, которая просто подогнана под прошлое."
          }
        }
      }
    },
