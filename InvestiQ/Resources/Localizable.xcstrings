    "news.intro": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Titulky od vašich poskytovatelů zpráv a oficiální tiskové zprávy. U každé zprávy je zdroj, způsob klasifikace a míra nejistoty. Zpráva není signál k jednání."
          }
