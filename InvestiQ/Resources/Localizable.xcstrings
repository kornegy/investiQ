    "onboarding.knowledge.note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znalosti a schopnost unést ztráty jsou různé věci. Vaše odpověď mění jen způsob vysvětlování."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowledge and the ability to absorb losses are different things. Your answer only changes how things are explained."
