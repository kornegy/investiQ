    "brokers.intro": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Informativní seznam regulovaných investičních firem relevantních pro Česko a EU. Seřazeno abecedně: bez žebříčku, bez doporučení, bez referenčních či partnerských odkazů. Zobrazují se jen údaje ověřené v oficiálních registrech nebo právních dokumentech firem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An informational list of regulated investment firms relevant for Czechia and the EU. Listed alphabetically: no ranking, no recommendation, no referral or affiliate links. Only facts checked against official registers or the firms' own legal documents are shown."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Информационный список регулируемых инвестиционных компаний, актуальных для Чехии и ЕС. В алфавитном порядке: без рейтинга, без рекомендаций, без реферальных и партнёрских ссылок. Показаны только сведения, проверенные по официальным реестрам или юридическим документам компаний."
          }
        }
      }
    },
