    "scenario.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesimistický, základní a optimistický = 20., 50. a 80. percentil všech minulých klouzavých výnosů nástroje za zvolený horizont (jen cena, bez dividend). Popisují minulost, ne budoucnost."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pessimistic, base and optimistic = 20th, 50th and 80th percentiles of all past rolling returns of this instrument over the chosen horizon (price only, without dividends). They describe the past, not the future."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пессимистичный, базовый и оптимистичный = 20-й, 50-й и 80-й процентили всех прошлых скользящих доходностей инструмента за выбранный горизонт (только цена, без дивидендов). Они описывают прошлое, а не будущее."
          }
        }
      }
    },
