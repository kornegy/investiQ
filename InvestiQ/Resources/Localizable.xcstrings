      }
    },
    "onboarding.risk.cautious": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velmi bych se znepokojil a možná prodal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I would be very worried and might sell"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сильно переживал бы и мог бы продать"
          }
        }
