    "asset.metric.volatility.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak silně cena kolísala. Vyšší volatilita znamená větší výkyvy oběma směry."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How strongly the price fluctuated. Higher volatility means larger swings in both directions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько сильно колебалась цена. Более высокая волатильность — более сильные колебания в обе стороны."
          }
        }
      }
    },
