    "settings.security.deleteProfile.warning": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže tento profil, všechna jeho data a klíče z tohoto Macu. Nelze to vrátit. Vámi vytvořené zálohy zůstanou tam, kam jste je uložili."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes this profile, all its data and its keys from this Mac. This cannot be undone. Backups you created stay where you saved them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет профиль, все его данные и ключи с этого Mac. Отменить это нельзя. Созданные вами резервные копии останутся там, где вы их сохранили."
          }
        }
      }
