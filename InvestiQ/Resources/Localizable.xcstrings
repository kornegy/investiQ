    "brokers.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje se mohou kdykoli změnit; před jakýmkoli krokem ověřte aktuální dokumenty firmy a oficiální registr. Uvedení v seznamu není doporučení a InvestiQ od uvedených firem nic nedostává."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Information can change at any time; always check the firm's current documents and the official register before acting. Inclusion is not a recommendation, and InvestiQ receives nothing from any firm listed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сведения могут измениться в любой момент; перед любыми действиями проверяйте актуальные документы компании и официальный реестр. Включение в список — не рекомендация, и InvestiQ ничего не получает от перечисленных компаний."
          }
        }
      }
    },
