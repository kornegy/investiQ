        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "InvestiQ nemá server ani vestavěné API klíče. Zadejte vlastní klíče — ukládají se jen do Klíčenky macOS. Poskytovatelé výše v seznamu se dotazují jako první."
          }
        },
        "en": {
          "stringUnit": {
