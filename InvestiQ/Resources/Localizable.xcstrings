    "settings.colorBlindPalette.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zisky se zobrazují modře a ztráty oranžově. Šipky a znaménka se zobrazují vždy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows gains in blue and losses in orange. Arrows and signs are always shown."
          }
        },
        "ru": {
