    "metric.pb.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena akcie ve srovnání s účetní hodnotou vlastního kapitálu na akcii."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
