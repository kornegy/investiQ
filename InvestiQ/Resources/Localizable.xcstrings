    "asset.metric.maxDrawdown.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Největší pokles od předchozího maxima v období. Budoucí poklesy mohou být větší."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The largest fall from a previous high within the period. Future falls can be larger."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наибольшее падение от предыдущего максимума за период. Будущие падения могут быть больше."
          }
        }
      }
    },
    "asset.metric.periodReturn": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
