            "value": "Install Ollama and a model yourself; InvestiQ does not download models. Only addresses on this Mac (127.0.0.1 or localhost) are accepted, so nothing leaves your computer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
