    "app.error.databaseUnreadable": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrovaná data se nepodařilo otevřít. Nebyla změněna. Můžete je obnovit ze zálohy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your encrypted data could not be opened. It has not been modified. You can restore it from a backup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть зашифрованные данные. Они не были изменены. Вы можете восстановить их из резервной копии."
          }
        }
      }
    },
    "app.error.demoUnavailable": {
