            "value": "Неизвестно"
          }
        }
      }
    },
    "risk.liquidity.explanation": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podíl pozic, jejichž prodej při 20 % průměrného denního objemu by trval déle než pět obchodních dní; jednotlivé dluhopisy se počítají jako méně likvidní (prahy 10 / 30 / 60 %)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share of positions that would take more than five trading days to sell at 20 % of average daily traded value; individual bonds count as less liquid (thresholds 10 / 30 / 60 %)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доля позиций, продажа которых при 20 % среднедневного оборота заняла бы более пяти торговых дней; отдельные облигации считаются менее ликвидными (пороги 10 / 30 / 60 %)."
          }
        }
      }
    },
    "risk.market.explanation": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podle roční volatility denních výnosů portfolia za poslední rok při současných vahách (prahy 8 / 15 / 25 %)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on the annualised volatility of daily portfolio returns over the last year at current weights (thresholds 8 / 15 / 25 %)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На основе годовой волатильности дневных доходностей портфеля за последний год при текущих весах (пороги 8 / 15 / 25 %)."
          }
        }
      }
    },
    "risk.methodNote": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úrovně se řídí publikovanými prahy (Metodika, §6). Popisují složení a historii portfolia, ne jeho budoucnost, a nejsou doporučením."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Levels follow published thresholds (Financial methodology §6). They describe the portfolio's composition and history, not its future, and are not recommendations."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уровни следуют опубликованным порогам (Методология, §6). Они описывают состав и историю портфеля, а не его будущее, и не являются рекомендациями."
          }
        }
      }
    },
    "risk.metric.cvar95": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Očekávaný schodek 95 % (1 den)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected shortfall 95 % (1 day)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидаемые потери 95 % (1 день)"
          }
        }
      }
    },
    "risk.metric.cvar95.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Průměrná jednodenní ztráta v nejhorších 5 % dní za poslední rok. Také nejde o maximální ztrátu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average one-day loss on the worst 5 % of days in the last year. Also not a maximum loss."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средний дневной убыток в худшие 5 % дней за последний год. Тоже не максимальный убыток."
          }
        }
      }
    },
    "risk.metric.duration": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vážená modifikovaná durace"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weighted modified duration"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взвешенная модифицированная дюрация"
          }
        }
      }
    },
    "risk.metric.duration.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přibližná procentní změna hodnoty portfolia při změně výnosů o 1 procentní bod, z dluhopisů a dluhopisových ETF (u ETF předpoklad 7 let)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate percentage change of the portfolio value for a 1 percentage point change in yields, from bonds and bond ETFs (7 years assumed for bond ETFs)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приблизительное процентное изменение стоимости портфеля при изменении доходностей на 1 п. п. за счёт облигаций и облигационных ETF (для ETF принято 7 лет)."
          }
        }
      }
    },
    "risk.metric.effectivePositions": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Efektivní počet pozic"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Effective number of positions"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эффективное число позиций"
          }
        }
      }
    },
    "risk.metric.effectivePositions.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "1 dělená Herfindahlovým indexem vah. Deset stejných pozic dává 10; jedna dominantní pozice tlačí hodnotu k 1."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 divided by the Herfindahl index of weights. Ten equal positions give 10; one dominant position pushes it towards 1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1, делённая на индекс Херфиндаля весов. Десять равных позиций дают 10; одна доминирующая позиция приближает значение к 1."
          }
        }
      }
    },
    "risk.metric.var95": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Historický VaR 95 % (1 den)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Historical VaR 95 % (1 day)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исторический VaR 95 % (1 день)"
          }
        }
      }
    },
    "risk.metric.var95.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V 95 % dní za poslední rok byla jednodenní ztráta při současných vahách menší než tato hodnota. Není to maximální možná ztráta: větší ztráty mohou nastat a nastávají."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On 95 % of days in the last year the one-day loss at current weights was smaller than this. It is not the maximum possible loss: larger losses can and do occur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В 95 % дней за последний год дневной убыток при текущих весах был меньше этой величины. Это не максимально возможный убыток: бывают и большие потери."
          }
        }
      }
    },
    "risk.metric.volatility": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volatilita (roční)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volatility (annualised)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Волатильность (годовая)"
          }
        }
      }
    },
    "risk.metric.volatility.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Směrodatná odchylka denních výnosů portfolia za poslední rok převedená na rok při současných vahách. Vyšší znamená větší výkyvy oběma směry."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard deviation of daily portfolio returns over the last year, scaled to a year, using current weights. Higher means larger swings in both directions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандартное отклонение дневных доходностей портфеля за последний год, приведённое к году, при текущих весах. Чем выше, тем сильнее колебания в обе стороны."
          }
        }
      }
    },
    "risk.political.explanation": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podíl aktiv ze zemí mimo rozvinuté trhy (prahy 10 / 30 / 60 %). Jen hrubý ukazatel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share of holdings from countries outside developed markets (thresholds 10 / 30 / 60 %). A rough indicator only."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доля активов из стран вне развитых рынков (пороги 10 / 30 / 60 %). Только приблизительный индикатор."
          }
        }
      }
    },
    "risk.portfolio": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
