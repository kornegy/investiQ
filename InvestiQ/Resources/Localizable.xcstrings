    "provider.coverage.finnhub": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzy z USA (se zpožděním), profily a ukazatele firem, zprávy a kalendář výsledků. Historie cen vyžaduje placený tarif."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "US quotes (delayed), company profiles and metrics, news and earnings calendar. Price history requires a paid plan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Котировки США (с задержкой), профили и показатели компаний, новости и календарь отчётов. История цен — только на платном тарифе."
          }
        }
      }
    },
    "provider.coverage.fmp": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Profily firem s ISIN, kurzy ke konci dne, hledání podle ISIN. Zdarma: 250 dotazů denně, pouze pro osobní použití."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Company profiles with ISIN, end-of-day quotes, ISIN search. Free plan: 250 requests per day, personal use only."
          }
        },
        "ru": {
