    "overview.risk.position": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tvoří %2$@ portfolia. Velká jednotlivá pozice zvyšuje riziko koncentrace."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ makes up %2$@ of the portfolio. A large single position increases concentration risk."
