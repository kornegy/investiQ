    "onboarding.summary.noNotes": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z vašich odpovědí nevyplývají žádná zvláštní bezpečnostní témata. Odpovědi můžete kdykoli změnit v nastavení."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No safety topics stand out from your answers. You can change them anytime in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По вашим ответам особых вопросов безопасности не выявлено. Ответы можно изменить в настройках."
          }
        }
      }
    },
    "onboarding.summary.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než začnete"
          }
        },
