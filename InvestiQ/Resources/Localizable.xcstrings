    "forecast.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognózy jsou statistické odhady s velkou nejistotou, nikoli předpovědi ani rady. Každá zaznamenaná prognóza zůstává v záznamu přesnosti, včetně těch nepřesných."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forecasts are statistical estimates with wide uncertainty, not predictions or advice. Every recorded forecast stays in the accuracy record, including the ones that miss."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогнозы — статистические оценки с большой неопределённостью, а не предсказания и не советы. Каждый записанный прогноз остаётся в журнале точности, включая неудачные."
          }
        }
      }
    },
