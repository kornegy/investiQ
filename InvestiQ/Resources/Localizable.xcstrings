    "analysis.status.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neutrální stavy odvozené z publikovaných pravidel. Ukazují, co si zaslouží pozornost, nikoli zda nakoupit či prodat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neutral statuses derived from published rules. They show what deserves closer attention, not whether to buy or sell."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нейтральные статусы по опубликованным правилам. Они показывают, на что стоит обратить внимание, а не покупать или продавать."
          }
        }
      }
    },
