          }
        }
      }
    },
    "planner.savings.monthly": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíční částka"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monthly amount"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежемесячная сумма"
          }
        }
      }
    },
    "planner.savings.nominal": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnota"
          }
