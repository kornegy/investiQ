        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "InvestiQ проверяет календарь только во время работы. Даты отчётности поступают от ваших поставщиков данных и часто предварительные."
          }
        }
      }
    },
    "calendar.intro": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plánovaná rozhodnutí centrálních bank, zveřejnění statistik a výsledky firem z vaší knihovny. Data se mohou změnit; u každé události je odkaz na zdroj."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled central bank decisions, statistics releases and earnings reports of instruments in your library. Dates can change; the source is linked for each event."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запланированные решения центральных банков, публикации статистики и отчёты компаний из вашей библиотеки. Даты могут меняться; у каждого события указан источник."
          }
        }
      }
    },
