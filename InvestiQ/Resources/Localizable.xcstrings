    "onboarding.risk.avoidLosses": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechci zažít žádnou ztrátu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I would not want to experience any loss"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я не хочу допускать никаких убытков"
          }
        }
      }
    },
    "onboarding.risk.balanced": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bylo by mi to nepříjemné, ale držel bych se plánu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I would be uneasy but stick to my plan"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Было бы неприятно, но я придерживался бы плана"
          }
        }
      }
    },
    "onboarding.risk.cautious": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velmi bych se znepokojil a možná prodal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I would be very worried and might sell"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сильно переживал бы и мог бы продать"
          }
        }
      }
    },
    "onboarding.risk.note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neexistuje správná odpověď. Postoj k riziku je jen část obrazu — schopnost unést ztráty závisí na vašich financích."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no right answer. Attitude to risk is only one part of the picture — your ability to absorb losses depends on your finances."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правильного ответа нет. Отношение к риску — лишь часть картины: способность пережить убытки зависит от ваших финансов."
          }
        }
      }
    },
    "onboarding.risk.question": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Představte si, že vaše investice během několika měsíců klesla o 20 %. Co byste nejspíš udělali?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine your investment fell by 20 % within a few months. What would you most likely do?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Представьте, что ваши вложения подешевели на 20 % за несколько месяцев. Как бы вы, скорее всего, поступили?"
          }
        }
      }
    },
    "onboarding.risk.title": {
