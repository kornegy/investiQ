    "calendar.footnote": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "InvestiQ kontroluje kalendář jen za běhu. Data výsledků pocházejí od vašich poskytovatelů dat a bývají předběžná."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "InvestiQ checks the calendar only while it is running. Earnings dates come from your data providers and are often preliminary."
          }
