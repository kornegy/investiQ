    "metric.pe": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena/zisk (P/E)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Price/earnings (P/E)"
          }
        },
        "ru": {
