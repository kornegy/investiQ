      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik dluhu má firma ve srovnání s vlastním kapitálem. Vyšší hodnota znamená větší finanční páku."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much debt the company has compared with its equity. Higher means more financial leverage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько долга у компании по сравнению с её капиталом. Чем выше, тем больше финансовый рычаг."
          }
