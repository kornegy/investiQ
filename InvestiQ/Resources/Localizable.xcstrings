          "stringUnit": {
            "state": "translated",
            "value": "Ни одному сценарию не присваивается вероятность. Результаты за пределами диапазона случались и могут повториться."
          }
        }
      }
    },
    "scenario.sensitivity.note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
