      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuální tržní hodnota držených aktiv (a hotovosti, pokud evidujete vklady) přepočtená na základní měnu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current market value of your holdings (and cash, if you record deposits), converted to your base currency."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущая рыночная стоимость активов (и денег, если вы вносите пополнения), пересчитанная в базовую валюту."
          }
        }
      }
    },
    "overview.metric.unrealized": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nerealizovaný zisk/ztráta"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unrealised gain/loss"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нереализованная прибыль/убыток"
          }
