    "forecast.record.intro": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá zaznamenaná prognóza se uchovává beze změn a po uplynutí data se porovná se skutečností. Ukazuje to, jak spolehlivé modely skutečně jsou."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every forecast you record is kept unchanged and compared with what actually happened once its date has passed. This shows how reliable the models really are."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый записанный прогноз хранится без изменений и сравнивается с фактическим результатом после наступления даты. Так видно, насколько надёжны модели на самом деле."
