    "ai.settings.guarantees": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "AI nemá žádné nástroje: nemůže obchodovat, spouštět příkazy ani měnit vaše data. Odpovědi se kontrolují podle pevného formátu; investiční rady, vymyšlené pravděpodobnosti a odkazy se odmítají nebo odstraňují."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI has no tools: it cannot trade, run commands or change your data. Answers are checked against a fixed format; investment advice, invented probabilities and invented links are rejected or removed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У ИИ нет инструментов: он не может совершать сделки, выполнять команды или менять данные. Ответы проверяются на соответствие формату; инвестиционные советы, выдуманные вероятности и ссылки отклоняются или удаляются."
          }
        }
      }
    },
    "ai.settings.intro": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "AI je volitelná. Umí vysvětlit pojmy a výsledky, shrnout zprávy a odpovídat na studijní otázky. Veškerá analytika InvestiQ funguje i bez ní a AI nikdy nepočítá zobrazená čísla."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is optional. It can explain terms and results, summarise news and answer learning questions. All analytics in InvestiQ work without it, and AI never calculates the figures you see."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ необязателен. Он может объяснять термины и результаты, кратко пересказывать новости и отвечать на учебные вопросы. Вся аналитика InvestiQ работает без него, и ИИ никогда не рассчитывает показанные цифры."
          }
        }
      }
    },
