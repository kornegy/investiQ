    "planner.budget.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte částky za měsíc (rezervu a úspory jako celkové částky). Pokud něco neplatí, zadejte 0; prázdná pole se berou jako neznámá, ne jako nula."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter amounts per month (the emergency fund and savings as totals). Enter 0 when something does not apply; blank fields are treated as unknown, not as zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите суммы в месяц (резервный фонд и сбережения — итоговыми суммами). Введите 0, если что-то не относится к вам; пустые поля считаются неизвестными, а не нулём."
          }
        }
      }
    },
