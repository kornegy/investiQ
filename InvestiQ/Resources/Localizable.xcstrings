    "analytics.drawdown.explanation": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Největší pokles činil %1$@ od maxima %2$@ do minima %3$@; cena později dosáhla předchozího maxima."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deepest fall was %1$@ from the high on %2$@ to the low on %3$@; the price later regained the previous high."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наибольшее падение составило %1$@ — от максимума %2$@ до минимума %3$@; позже цена вернулась к прежнему максимуму."
          }
        }
      }
    },
    "analytics.drawdown.explanationNotRecovered": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Největší pokles činil %1$@ od maxima %2$@ do minima %3$@; předchozí maximum v tomto období nebylo dosaženo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deepest fall was %1$@ from the high on %2$@ to the low on %3$@; the previous high has not been regained in this period."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наибольшее падение составило %1$@ — от максимума %2$@ до минимума %3$@; в этом периоде прежний максимум не восстановлен."
          }
        }
      }
    },
    "analytics.input.dailyReturns": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
