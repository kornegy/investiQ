    "stress.assumption.beta": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Akcie a akciové ETF klesnou o šok vynásobený jejich betou; kde beta není známa, předpokládá se 1 (označeno)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocks and equity ETFs fall by the shock multiplied by their beta; a beta of 1 is assumed where it is unknown (marked)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Акции и фондовые ETF падают на величину шока, умноженную на их бету; где бета неизвестна, принимается 1 (помечено)."
          }
        }
      }
    },
    "stress.assumption.credit": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výnosy podnikových dluhopisů vzrostou o šok spreadu; státní dluhopisy se nemění."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Corporate bond yields rise by the spread shock; government bonds are unchanged."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доходности корпоративных облигаций растут на величину шока спреда; государственные облигации не меняются."
          }
        }
      }
    },
    "stress.assumption.currency": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiva v cizích měnách ztratí v základní měně velikost šoku; kde je znám, použije se měnový rozpad fondů."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assets in foreign currencies lose the shock in base-currency terms; fund currency look-through is used where known."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активы в иностранных валютах теряют величину шока в базовой валюте; где известно, учитывается валютный состав фондов."
          }
        }
      }
    },
    "stress.assumption.default": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dluhopisy emitenta získají zpět 40 % hodnoty; akcie emitenta se ztratí úplně."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonds of the issuer recover 40 % of their value; shares of the issuer are lost entirely."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Облигации эмитента возмещают 40 % стоимости; акции эмитента теряются полностью."
          }
        }
      }
    },
    "stress.assumption.inflation": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukazuje ztrátu kupní síly nominálních dluhopisů a hotovosti; dopad na akcie se nemodeluje."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the loss of purchasing power of nominal bonds and cash; the effect on stocks is not modelled."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает потерю покупательной способности номинальных облигаций и денежных средств; влияние на акции не моделируется."
          }
        }
      }
    },
    "stress.assumption.rates": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dluhopisy se plně přecení při posunutém výnosu; u dluhopisových ETF se předpokládá durace 7 let (označeno)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonds are fully repriced at the shifted yield; bond ETFs use an assumed duration of 7 years (marked)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Облигации полностью переоцениваются по сдвинутой доходности; для облигационных ETF принята дюрация 7 лет (помечено)."
          }
        }
      }
    },
    "stress.banner": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zátěžové testy jsou hypotetické. Ukazují, jak by současné portfolio reagovalo na předpokládaný šok, ne co se stane."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stress tests are hypothetical. They show how the current portfolio would react to an assumed shock, not what will happen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стресс-тесты гипотетические. Они показывают, как текущий портфель отреагировал бы на условный шок, а не то, что произойдёт."
          }
        }
      }
    },
    "stress.details": {
