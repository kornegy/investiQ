          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсутствуют ключевые сведения о фонде (расходы, состав или метод репликации)."
          }
        }
      }
    },
    "rule.highLeverage": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poměr dluhu k vlastnímu kapitálu %@ je nad prahem 2,0."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
