    "simulator.insight.concentration": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tvoří %2$@ portfolia. Jednotlivá pozice může prudce klesnout."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ makes up %2$@ of the portfolio. A single position can fall sharply."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ составляет %2$@ портфеля. Отдельная позиция может резко подешеветь."
          }
        }
      }
    },
    "simulator.insight.fees": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Náklady přibližně %@ počátečního kapitálu ročně. Náklady snižují výnos rok co rok."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Costs of about %@ of the starting capital per year. Costs reduce returns year after year."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расходы около %@ стартового капитала в год. Расходы снижают доходность год за годом."
          }
        }
      }
    },
    "simulator.insight.frequent": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přibližně %@ obchodů měsíčně. Časté obchodování výsledky po započtení nákladů zřídka zlepší."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About %@ trades per month. Trading often rarely improves results once costs are included."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Около %@ сделок в месяц. Частая торговля редко улучшает результат с учётом расходов."
          }
        }
      }
    },
    "simulator.insight.idleCash": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ portfolia je hotovost. Pokud je to záměr, je to v pořádku; hotovost neroste a ztrácí hodnotu inflací."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of the portfolio is cash. That is fine if intended; cash does not grow and loses value to inflation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ портфеля — денежные средства. Это нормально, если так задумано; деньги не растут и обесцениваются инфляцией."
          }
        }
      }
    },
    "simulator.insight.sellingAfterFall": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ prodej(e) proběhl(y) po poklesu o 10 %% a více. Prodej po poklesu realizuje ztrátu; stojí za to se zeptat, zda se změnil důvod držení."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sale(s) happened after a fall of 10 %% or more. Selling after falls locks in losses; it is worth asking whether the reason for owning changed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ продаж(и) произошли после падения на 10 %% и более. Продажа после падения фиксирует убытки; стоит спросить себя, изменилась ли причина владения."
          }
        }
      }
    },
    "simulator.insight.turnover": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Roční obrat přibližně %@. Časté nakupování a prodávání ve skutečnosti přidává náklady a daně."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Annual turnover of about %@. Frequent buying and selling adds costs and taxes in real life."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Годовой оборот около %@. Частые покупки и продажи в реальности добавляют расходы и налоги."
          }
        }
      }
    },
    "simulator.insights.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednoduché kontroly vašeho cvičného obchodování. Popisují návyky, které často stojí peníze; nejde o hodnocení."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple checks of your simulated trading. They describe habits that often cost money; they are not judgements."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Простые проверки вашей учебной торговли. Они описывают привычки, которые часто стоят денег; это не оценки."
          }
        }
      }
    },
    "simulator.insights.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzorce k zamyšlení"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Patterns to reflect on"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закономерности для размышления"
          }
        }
      }
    },
    "simulator.intro": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Procvičujte s virtuálními penězi. Uplatňují se poplatky, spready, převod měn a zpoždění dat. Nejsou zde žebříčky ani odměny: cílem je učit se, ne více obchodovat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practise with virtual money. Fees, spreads, currency conversion and data delays are applied. There are no rankings or rewards: the point is to learn, not to trade more."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Практикуйтесь на виртуальных деньгах. Учитываются комиссии, спреды, конвертация валют и задержки данных. Здесь нет рейтингов и наград: цель — учиться, а не торговать больше."
          }
        }
      }
    },
    "simulator.liveNote": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny pocházejí od vašich poskytovatelů dat a mohou být zpožděné; zpoždění je uvedeno u každé ceny."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices come from your data providers and may be delayed; the delay is shown with each price."
