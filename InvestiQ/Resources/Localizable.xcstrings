        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У InvestiQ нет сервера и нет встроенных API-ключей. Введите свои ключи — они хранятся только в связке ключей macOS. Поставщики выше в списке опрашиваются первыми."
          }
        }
      }
