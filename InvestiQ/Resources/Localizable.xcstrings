    "welcome.point.noAdvice": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné signály „kup/prodej“ ani sliby — vysvětlení a průhledné výpočty."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No buy/sell signals, no promises — explanations and transparent calculations."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никаких сигналов «купить/продать» и обещаний — объяснения и прозрачные расчёты."
          }
        }
      }
    },
    "welcome.point.sources": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U každého čísla vidíte zdroj a jeho aktuálnost."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every number shows its source and how fresh it is."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого числа указан источник и актуальность."
          }
        }
      }
    },
    "welcome.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naučte se rozumět akciím, dluhopisům a ETF, poctivě evidujte své investice a přemýšlejte o riziku — svým tempem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn to understand stocks, bonds and ETFs, track your investments honestly and think about risk — at your own pace."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Научитесь разбираться в акциях, облигациях и ETF, честно учитывайте свои инвестиции и оценивайте риск — в своём темпе."
          }
        }
      }
