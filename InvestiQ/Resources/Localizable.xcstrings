    "provider.coverage.alphavantage": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Akcie a ETF na mnoha burzách, denní ceny a přehledy firem. Bezplatný klíč: asi 25 dotazů denně, jen nedávná historie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocks and ETFs on many exchanges, daily prices and company overviews. Free key: about 25 requests per day, recent history only."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Акции и ETF на многих биржах, дневные цены и обзоры компаний. Бесплатный ключ: около 25 запросов в день, только недавняя история."
          }
        }
      }
    },
    "provider.coverage.cnb": {
      "extractionState": "manual",
      "localizations": {
