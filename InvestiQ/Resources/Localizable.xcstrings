    "notifications.privacy": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení se mohou zobrazit na zamčené obrazovce. Obsahují názvy nástrojů a procenta, nikdy částky ani velikost pozic."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications can appear on the lock screen. They contain instrument names and percentages, never amounts or holdings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления могут появляться на экране блокировки. В них есть названия инструментов и проценты, но никогда суммы или размеры позиций."
          }
        }
      }
    },
    "notifications.runningOnly": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "InvestiQ kontroluje oznámení jen tehdy, když je otevřený (po odemčení a přibližně každých 30 minut). Když je zavřený nebo Mac spí, nic nesleduje."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "InvestiQ checks for notifications only while it is open (on unlock and about every 30 minutes). It does not monitor anything when it is closed or your Mac is asleep."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "InvestiQ проверяет уведомления только когда открыт (при разблокировке и примерно каждые 30 минут). Когда приложение закрыто или Mac спит, ничего не отслеживается."
          }
        }
      }
    },
