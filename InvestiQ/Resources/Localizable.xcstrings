    "disclaimer.generalInformation": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jde o obecné informace, nikoli o osobní doporučení. Investování je spojeno s rizikem včetně ztráty kapitálu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is general information, not a personal recommendation. Investing involves risk, including the loss of capital."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это общая информация, а не персональная рекомендация. Инвестирование связано с риском, включая потерю капитала."
          }
        }
      }
    },
    "disclaimer.notAdvice": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "InvestiQ je vzdělávací a analytický nástroj. Neposkytuje investiční poradenství, neprovádí obchody a neslibuje výnosy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "InvestiQ is an educational and analytical tool. It does not provide investment advice, does not execute transactions and does not promise returns."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "InvestiQ — образовательный и аналитический инструмент. Он не даёт инвестиционных советов, не совершает сделок и не обещает доходность."
          }
        }
      }
    },
