    "legal.investorProtection": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systémy ochrany investorů mohou v zákonných mezích krýt ztráty způsobené selháním zprostředkovatele. Proti tržním ztrátám nechrání nikdy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Investor protection schemes can cover losses caused by the failure of an intermediary within legal limits. They never protect against market losses."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системы защиты инвесторов могут компенсировать потери из-за банкротства посредника в пределах закона. От рыночных убытков они не защищают никогда."
          }
        }
      }
    },
    "legal.noTelemetry": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "InvestiQ ukládá vaše data pouze na tomto Macu, šifrovaně. Neobsahuje analytiku ani sledování."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "InvestiQ stores your data only on this Mac, encrypted. It contains no analytics or tracking."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "InvestiQ хранит ваши данные только на этом Mac в зашифрованном виде. В приложении нет аналитики и отслеживания."
          }
        }
      }
    },
    "legal.riskDisclosure": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnota investic může klesat i stoupat. Minulá výkonnost nezaručuje budoucí výsledky. Historické statistiky, scénáře a modely popisují pouze minulost a předpoklady modelů."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The value of investments can fall as well as rise. Past performance does not guarantee future results. Historical statistics, scenarios and models describe the past and model assumptions only."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоимость инвестиций может как расти, так и падать. Прошлая доходность не гарантирует будущих результатов. Исторические статистики, сценарии и модели описывают только прошлое и допущения моделей."
          }
        }
      }
    },
