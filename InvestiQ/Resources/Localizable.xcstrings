    "analytics.limitation.pastNotFuture": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vychází z minulých cen a nepředpovídá budoucnost."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on past prices; it does not predict the future."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основано на прошлых ценах и не предсказывает будущее."
          }
        }
      }
    },
    "analytics.limitation.tooFewObservations": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K dispozici je jen %1$@ pozorování; potřeba je alespoň %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only %1$@ observations available; at least %2$@ are needed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно только %1$@ наблюдений; нужно не менее %2$@."
          }
        }
      }
    },
    "analytics.limitation.unadjustedPrices": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny nejsou upraveny o splity."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices are not adjusted for splits."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены не скорректированы на сплиты."
          }
        }
      }
    },
    "analytics.methodFooter": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Metoda %1$@ · úplnost dat %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Method %1$@ · data completeness %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метод %1$@ · полнота данных %2$@"
          }
        }
      }
    },
    "analytics.volatility.explanation": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Denní pohyby ceny odpovídaly přibližně %@ ročně. Na klidném trhu je hodnota nižší, na neklidném vyšší."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily price moves corresponded to about %@ per year. In calmer markets this figure is lower, in turbulent ones higher."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дневные колебания цены соответствовали примерно %@ в год. На спокойном рынке показатель ниже, на турбулентном — выше."
          }
        }
      }
    },
    "app.error.databaseUnreadable": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrovaná data se nepodařilo otevřít. Nebyla změněna. Můžete je obnovit ze zálohy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your encrypted data could not be opened. It has not been modified. You can restore it from a backup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть зашифрованные данные. Они не были изменены. Вы можете восстановить их из резервной копии."
          }
        }
      }
    },
