    "forecast.verdict.notUseful": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: nepřekonal naivní základ. Nepoužívejte jej jako investiční signál."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: did not outperform the naive baseline. Do not use it as an investment signal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: не превзошла наивный прогноз. Не используйте её как инвестиционный сигнал."
          }
        }
      }
    },
    "forecast.verdict.useful": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: v tomto testu překonal naivní základ a jeho intervaly byly přiměřeně kalibrované. Minulá přesnost nezaručuje budoucí."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: beat the naive baseline in this test and its intervals were reasonably calibrated. Past accuracy does not guarantee future accuracy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: в этой проверке превзошла наивный прогноз, интервалы были достаточно откалиброваны. Прошлая точность не гарантирует будущую."
          }
        }
      }
    },
    "import.confirm": {
