      }
    },
    "overview.metric.unrealized.help": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdíl mezi aktuální hodnotou a pořizovací cenou držených aktiv. Mění se, dokud neprodáte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Difference between current value and cost basis of holdings you still own. It changes until you sell."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разница между текущей стоимостью и себестоимостью текущих активов. Меняется, пока вы не продадите."
          }
        }
      }
    },
