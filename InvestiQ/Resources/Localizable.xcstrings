    "risk.inflation.explanation": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podíl dluhopisů, dluhopisových fondů a hotovosti, jejichž pevné nominální platby ztrácejí kupní sílu při růstu inflace (prahy 20 / 50 / 80 %)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share in bonds, bond funds and cash, whose fixed nominal payments lose purchasing power when inflation rises (thresholds 20 / 50 / 80 %)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доля облигаций, облигационных фондов и денежных средств, чьи фиксированные номинальные выплаты теряют покупательную способность при росте инфляции (пороги 20 / 50 / 80 %)."
          }
        }
      }
    },
    "risk.interestRate.explanation": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnotou vážená modifikovaná durace dluhopisů; u dluhopisových ETF se předpokládá durace 7 let (prahy 1 / 3 / 6)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Value-weighted modified duration of bonds; bond ETFs use an assumed duration of 7 years (thresholds 1 / 3 / 6)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взвешенная по стоимости модифицированная дюрация облигаций; для облигационных ETF принята условная дюрация 7 лет (пороги 1 / 3 / 6)."
          }
        }
      }
    },
    "risk.level.elevated": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvýšené"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevated"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повышенный"
          }
        }
